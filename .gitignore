# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov
*.info

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# Temporary files
*.DS_Store

# Coverage reports written by LocalCoverage
/coverage/

# Documenter output
/docs/build/
/docs/site/

# Files generated by Pkg, the package manager, based on the corresponding
# Project.toml. They record a fixed state of all packages used by the project.
# As such, they should not be committed for packages, but should be committed
# for applications that require a static environment.
/Manifest.toml
/docs/Manifest.toml
/test/Manifest.toml

/.vscode
